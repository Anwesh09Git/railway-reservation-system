PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/railway_reservation
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173

# If MongoDB is unreachable, start an auto-seeded in-memory demo database.
# Set to false to require a real MongoDB / Atlas connection.
USE_MEMORY_DB=true
